{
  "name": "@directo/template-builder",
  "version": "0.0.2",
  "type": "module",
  "main": "./lib-sdk/react-lib/dist/index.js",
  "module": "./lib-sdk/react-lib/dist/index.js",
  "types": "./lib-sdk/react-lib/dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./lib-sdk/react-lib/dist/index.js",
      "types": "./lib-sdk/react-lib/dist/index.d.ts"
    },
    "./react": {
      "import": "./lib-sdk/react-lib/dist/react/index.js",
      "types": "./lib-sdk/react-lib/dist/react/index.d.ts"
    },
    "./template-builder-ui": {
      "import": "./template-builder-ui/dist/index.js",
      "types": "./template-builder-ui/dist/index.d.ts"
    },
    "./template-builder-ui/style.css": "./template-builder-ui/dist/style.css"
  },
  "scripts": {
    "prepare": "cd lib-sdk/react-lib && npm install && npm run build",
    "build:lib": "cd lib-sdk/react-lib && npm run build",
    "build:ui": "cd template-builder-ui && npm install && npm run build",
    "build:react": "cd client-react && npm run build",
    "build:flutter:android": "cd client_flutter && flutter build apk",
    "build:flutter:ios": "cd client_flutter && flutter build ios --no-codesign",
    "build:flutter": "concurrently \"npm run build:flutter:android\" \"npm run build:flutter:ios\"",
    "build:all": "npm run build:lib && npm run build:ui && concurrently \"npm run build:react\" \"npm run build:flutter\"",
    "test:all": "npm test --prefix lib-sdk/react-lib && cd lib-sdk/flutter-sdk && flutter test"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
