{
  "extends": "./tsconfig.build.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["./*"]
    },
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "emitDeclarationOnly": false,
    "noEmit": true
  },
  "include": ["."],
  "exclude": ["dist", "node_modules"]
}
